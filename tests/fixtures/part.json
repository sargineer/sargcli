{
 "digest": {
  "bringup": {
   "intro": "From a bare board to a verified MeshCore node over USB, no web flasher.",
   "source": "sarg/flash-meshcore-onto-heltec-wifi-lora-32-v4",
   "steps": [
    {
     "title": "Flash MeshCore headless",
     "desc": "curl flasher.meshcore.io/releases for the merged bin URL, esptool erase-flash, then write-flash 0x0 with --after watchdog-reset; set the radio from the CLI with meshcore-cli set radio to match your mesh.",
     "ref": "sarg/flash-meshcore-onto-heltec-wifi-lora-32-v4"
    },
    {
     "title": "Turn on the front-end module",
     "desc": "The V4 FEM is off by default and costs 19 dB: the front-end LDO hangs on GPIO7 with the module chip select on GPIO2. Found by sweeping control-pin combinations and encoding the combination number into the transmitted payload.",
     "ref": "sargbench1/a-heltec-v4-s-front-end-module-is"
    },
    {
     "title": "Enable telemetry on the node you will query",
     "desc": "Remote telemetry is off by default and queries time out after 10 s until it is enabled \u2014 on the queried node, not the querying one. Environment and location reporting are configured separately from the base mode.",
     "ref": "sargbench1/meshcore-remote-telemetry-is-off-by-default-queries"
    },
    {
     "title": "Test on a private channel",
     "desc": "Move both nodes to a private radio configuration for the duration and restore afterwards \u2014 benchmarking on the live mesh channel contaminates the baseline. Verify the restore independently rather than trusting the tool.",
     "ref": "sargbench1/move-a-lora-soak-test-onto-a-private"
    },
    {
     "title": "Prove the link end to end",
     "desc": "Cause a physical change you control on the far node and watch the reported value follow it with the right shape and lag \u2014 a number that never moves is a cache, not a measurement.",
     "ref": "sargbench1/prove-remote-telemetry-is-live-by-forcing-a"
    }
   ]
  },
